<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Finance Dashboard</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      background: #f4f6f8;
      color: #222;
    }

    .sidebar {
      position: fixed;
      width: 230px;
      height: 100vh;
      background: #111827;
      color: white;
      padding: 25px 20px;
    }

    .sidebar h2 {
      margin-bottom: 35px;
    }

    .sidebar p {
      padding: 14px 10px;
      margin: 5px 0;
      border-radius: 8px;
      cursor: pointer;
    }

    .sidebar p:hover {
      background: #374151;
    }

    .main {
      margin-left: 230px;
      padding: 30px;
    }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
    }

    .header h1 {
      font-size: 28px;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-bottom: 30px;
    }

    .card {
      background: white;
      padding: 22px;
      border-radius: 14px;
      box-shadow: 0 3px 12px rgba(0,0,0,0.06);
    }

    .card h3 {
      color: #6b7280;
      font-size: 14px;
      margin-bottom: 10px;
    }

    .card h2 {
      font-size: 25px;
    }

    .content {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 20px;
    }

    .box {
      background: white;
      padding: 25px;
      border-radius: 14px;
      box-shadow: 0 3px 12px rgba(0,0,0,0.06);
    }

    .box h2 {
      margin-bottom: 20px;
    }

    .bar {
      display: flex;
      align-items: center;
      margin: 18px 0;
    }

    .bar span {
      width: 100px;
    }

    .bar-line {
      height: 15px;
      background: #2563eb;
      border-radius: 10px;
    }

    .food {
      width: 70%;
    }

    .shopping {
      width: 45%;
    }

    .transport {
      width: 30%;
    }

    .bills {
      width: 55%;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th, td {
      text-align: left;
      padding: 14px 8px;
      border-bottom: 1px solid #eee;
    }

    th {
      color: #6b7280;
    }

    .income {
      color: green;
    }

    .expense {
      color: red;
    }

    @media (max-width: 900px) {
      .cards {
        grid-template-columns: repeat(2, 1fr);
      }

      .content {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 600px) {
      .sidebar {
        display: none;
      }

      .main {
        margin-left: 0;
      }

      .cards {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>

  <div class="sidebar">
    <h2>💰 Finance</h2>

    <p>📊 Dashboard</p>
    <p>💳 Transactions</p>
    <p>📈 Investments</p>
    <p>💵 Budget</p>
    <p>⚙️ Settings</p>
  </div>

  <div class="main">

    <div class="header">
      <h1>Financial Dashboard</h1>
      <p>Welcome back 👋</p>
    </div>

    <div class="cards">

      <div class="card">
        <h3>Total Balance</h3>
        <h2>Rs. 250,000</h2>
      </div>

      <div class="card">
        <h3>Income</h3>
        <h2 class="income">Rs. 100,000</h2>
      </div>

      <div class="card">
        <h3>Expenses</h3>
        <h2 class="expense">Rs. 45,000</h2>
      </div>

      <div class="card">
        <h3>Savings</h3>
        <h2>Rs. 55,000</h2>
      </div>

    </div>

    <div class="content">

      <div class="box">
        <h2>Monthly Spending</h2>

        <div class="bar">
          <span>Food</span>
          <div class="bar-line food"></div>
        </div>

        <div class="bar">
          <span>Shopping</span>
          <div class="bar-line shopping"></div>
        </div>

        <div class="bar">
          <span>Transport</span>
          <div class="bar-line transport"></div>
        </div>

        <div class="bar">
          <span>Bills</span>
          <div class="bar-line bills"></div>
        </div>

      </div>

      <div class="box">
        <h2>Budget</h2>

        <p>Monthly Budget</p>
        <h2>Rs. 80,000</h2>

        <p>Spent: Rs. 45,000</p>
        <p>Remaining: Rs. 35,000</p>
      </div>

    </div>

    <br>

    <div class="box">
      <h2>Recent Transactions</h2>

      <table>
        <tr>
          <th>Description</th>
          <th>Category</th>
          <th>Amount</th>
        </tr>

        <tr>
          <td>Salary</td>
          <td>Income</td>
          <td class="income">+Rs. 100,000</td>
        </tr>

        <tr>
          <td>Grocery</td>
          <td>Food</td>
          <td class="expense">-Rs. 8,000</td>
        </tr>

        <tr>
          <td>Internet Bill</td>
          <td>Bills</td>
          <td class="expense">-Rs. 2,000</td>
        </tr>

        <tr>
          <td>Bus / Taxi</td>
          <td>Transport</td>
          <td class="expense">-Rs. 3,000</td>
        </tr>

      </table>
    </div>

  </div>

</body>
</html>
